cabal-version: 3.0
name:          kiroku-compaction-consumer
version:       0.1.0.0
build-type:    Simple

executable kiroku-compaction-consumer
  main-is:            Main.hs
  default-language:   GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:        -Wall -threaded
  build-depends:
    , aeson                    >=2.1      && <2.3
    , base                     >=4.18     && <5
    , containers               >=0.6      && <0.8
    , ephemeral-pg             >=0.3.1    && <0.4
    , hasql                    >=1.10     && <1.11
    , kiroku-store             ==0.13.0.0
    , kiroku-store-migrations  ==0.7.3.0
    , pg-migrate               ^>=1.2.0.0
    , text                     >=2.0      && <2.2
    , vector                   >=0.13     && <0.14
