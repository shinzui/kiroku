cabal-version: 3.0
name:          script-error-consumer
version:       0.1.0.0
build-type:    Simple

executable script-error-consumer
  main-is:          Main.hs
  default-language: GHC2024
  ghc-options:      -threaded
  build-depends:
    , base                     >=4.18     && <5
    , directory
    , ephemeral-pg             ==0.3.1.0
    , hasql                    >=1.10     && <1.11
    , hasql-transaction        >=1.1      && <1.3
    , http-types
    , kiroku-metrics           ==0.3.0.1
    , kiroku-store             ==0.11.0.1
    , kiroku-store-migrations  ==0.7.1.0
    , pg-migrate               ==1.2.0.0
    , wai
